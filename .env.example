# Copy this file to .env and adjust. Never commit the real .env file.

# PostgreSQL connection for the running app (docker compose default shown)
DATABASE_URL=postgres://edge:edge@localhost:5432/edge_dev

# Separate database used only by the automated tests (it is wiped on every test run)
TEST_DATABASE_URL=postgres://edge:edge@localhost:5432/edge_test

# Port for the API server (the web dev server proxies /api to it)
PORT=3001

# Session lifetime in hours
SESSION_TTL_HOURS=12

# Set to "true" only behind HTTPS (production/staging) so cookies are marked Secure
COOKIE_SECURE=false

# Allows the demo seed to run. Must be false/absent in production.
ALLOW_DEMO_SEED=true
